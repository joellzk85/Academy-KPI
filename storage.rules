rules_version = '2';

// NEXT Academy CRM file storage rules (2026-10-18). Publish in Firebase console → Storage → Rules.
// - Proposal files on deals: proposals/{dealId}/{fileId}_{name}. Records are in Firestore proposal_files.
// - Only logged-in, active team members (checked against the database's auth_map) can read or add.
// - Up to 100 MB; PDF, Word or PowerPoint; the uploader is recorded and can't be faked.
// - Only the uploader or Management can delete. Files are never changed after upload.
// - Files on admin checklist steps (2026-10-19): checklist_files/{dealId}/{fileId}_{name}, Admin and Management upload.
// - Everything else in storage is closed.
service firebase.storage {
  match /b/{bucket}/o {
    function link() {
      return /databases/(default)/documents/auth_map/$(request.auth.uid);
    }
    function isMember() {
      return request.auth != null && firestore.exists(link()) && firestore.get(link()).data.active == true;
    }
    function isManagement() {
      return isMember() && firestore.get(link()).data.role == 'management';
    }
    function isStaff() {
      return isMember() && firestore.get(link()).data.role in ['admin', 'management'];
    }

    match /proposals/{dealId}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd[.]ms-powerpoint|vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|presentationml[.]presentation))')
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if isMember() && (resource.metadata.uploadedBy == request.auth.uid || isManagement());
    }

    // Files on admin checklist steps (JD14, T3, Output assessment; 2026-10-19): checklist_files/{dealId}/{fileId}_{name}.
    // Admin and Management upload; up to 100 MB; PDF, Word, Excel, JPG or PNG. Records are in Firestore checklist_files.
    match /checklist_files/{dealId}/{fileName} {
      allow read: if isMember();
      allow create: if isStaff()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd[.]ms-excel|vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet))|image/(jpeg|png)')
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if isStaff() && (resource.metadata.uploadedBy == request.auth.uid || isManagement());
    }

    // Photos for teambuilding proposals, activities, trainers and venues (2026-10-19): photos/{folder}/{id}.jpg.
    // Every member uploads (made smaller in the browser first); up to 10 MB; JPG, PNG or WebP.
    // Never changed or deleted from the CRM, so a proposal that uses a photo never loses it.
    match /photos/{folder}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && folder in ['activities', 'trainers', 'venues', 'covers']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
