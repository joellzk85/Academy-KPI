rules_version = '2';

// NEXT Academy CRM database rules (Phase 3 + My home + shared quotations + deal deletion + client deletion + course outlines + trainer and venue deletion + to-do tasks + Google Calendar)
// - The Team list is readable by the login screen; only the CRM server changes it.
// - Passwords live in 'secrets', which no browser can ever read.
// - Everything else requires a logged-in, active team member.
// - The old plain-text password store can no longer be read by anyone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myLinkPath() {
      return /databases/$(database)/documents/auth_map/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(myLinkPath()) && get(myLinkPath()).data.active == true;
    }
    function isManagement() {
      return isMember() && get(myLinkPath()).data.role == 'management';
    }
    function isStaff() {
      return isMember() && get(myLinkPath()).data.role in ['admin', 'management'];
    }
    function ownerOf(data) {
      return data.get('ownerId', data.get('creatorId', ''));
    }

    // People: names and roles (shown on the login screen).
    // Only the CRM server changes these, after checking Management's login.
    match /team/{memberId} {
      allow read: if true;
      allow write: if false;
    }

    // Links each login to a team member and role (used by these rules).
    match /auth_map/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManagement());
      allow write: if false;
    }

    // Scrambled passwords: only the CRM server may touch these.
    match /secrets/{memberId} {
      allow read, write: if false;
    }

    // Settings. The admin checklist's master task list and money settings: Admin and Management only.
    // sales_target (the company sales target and its period): Management only.
    // google_calendar (the shared Google Calendar's ID and sync status) and backup_settings (the backup Google Sheet
    // and last result) are written only by the CRM server.
    match /config/{docId} {
      allow read: if docId == 'setup' || (isMember() && docId != 'passwords');
      allow create, update: if (isMember() && !(docId in ['passwords', 'setup', 'checklist_tasks', 'money_settings', 'google_calendar', 'backup_settings', 'sales_target']))
                            || (docId in ['checklist_tasks', 'money_settings'] && isStaff())
                            || (docId == 'sales_target' && isManagement());
      allow delete: if (docId in ['passwords', 'sales_target'] && isManagement())
                    || (isMember() && !(docId in ['passwords', 'setup', 'checklist_tasks', 'money_settings', 'google_calendar', 'backup_settings', 'sales_target']));
    }

    // Deals: reps change only their own; anyone asked to help may tick "done".
    match /pipelines/{dealId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isStaff()
        || (isMember() && ownerOf(resource.data) == request.auth.uid)
        || (isMember()
            && request.auth.uid in resource.data.get('taggedRepIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedTags']));
      // Delete: only the person who created the deal, or Management, and never a won deal.
      allow delete: if resource.data.get('stage', '') != 'won'
        && (isManagement()
            || (isMember() && resource.data.get('creatorId', resource.data.get('ownerId', '')) == request.auth.uid));
    }

    // Admin checklist per won deal (Phase 2B). Everyone can see progress.
    // The deal's owner may start it when marking the deal won; only Admin and
    // Management can tick, change or remove it.
    match /deal_checklists/{dealId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && ownerOf(get(/databases/$(database)/documents/pipelines/$(dealId)).data) == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // Programme list (Phase 2C). Anyone can add a new programme from a deal,
    // but only as "not registered"; only Admin and Management change its HRDC status.
    match /programmes/{programmeId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.resource.data.hrdcStatus == 'not_registered');
      allow update, delete: if isStaff();
    }

    // HRDC queries on a deal (Phase 2C): everyone sees them; Admin and Management handle them.
    match /hrdc_queries/{queryId} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Money in (Phase 3): HRDC claims and client invoices. Reps may see their
    // payment status; only Admin and Management record or change them.
    match /money_in/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Money out (Phase 3): payment requests. Admin and Management only.
    // - Raised as "pending" by the person requesting it.
    // - Approved or rejected only by a manager who did NOT raise it.
    // - Only approved items can be marked paid (and that can be undone).
    match /money_out/{id} {
      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedById == request.auth.uid;
      allow update: if isStaff() && (
        // approve or reject
        (isManagement()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && resource.data.requestedById != request.auth.uid
          && request.resource.data.decidedById == request.auth.uid
          && changedOnly(['status', 'decidedById', 'decidedByName', 'decidedAt', 'rejectReason']))
        // mark paid, or undo paid
        || (((resource.data.status == 'approved' && request.resource.data.status == 'paid')
             || (resource.data.status == 'paid' && request.resource.data.status == 'approved'))
          && changedOnly(['status', 'paidDate', 'paidRef', 'paidById', 'paidByName']))
      );
      allow delete: if isStaff()
        && resource.data.status in ['pending', 'rejected']
        && (resource.data.requestedById == request.auth.uid || isManagement());
    }

    // Quotations: reps change their own, ones shared with them, or ones they're asked to help on;
    // Admin and Management can change any. Old shared templates with no owner stay open.
    match /quotations/{quoteId} {
      function quotePeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in quotePeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in quotePeople(resource.data)
                           || resource.data.get('taggedRepId', '') == request.auth.uid
                           || request.auth.uid in resource.data.get('sharedWithIds', [])
                           || (resource.data.get('ownerId', '') == '' && resource.data.get('creatorId', '') == '')));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in quotePeople(resource.data));
    }

    // What the CRM has sent to the shared Google Calendar: only the CRM server uses this.
    match /calendar_sync/{id} {
      allow read, write: if false;
    }

    // Trainers: every team member can add and edit; only Management can delete.
    match /trainers_directory/{trainerId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // Venues: every team member can add and edit; only Management can delete.
    match /venues_directory/{venueId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // To-do tasks (2026-10-17): one shared task per job. Anyone adds a task as themselves; the person it's
    // assigned to and the person who assigned it can change it; only the assigner or Management can delete.
    // Older tasks may only have ownerRepId (whose list they sat in), so that counts too.
    match /tasks/{taskId} {
      function taskPeople(d) {
        return [d.get('assignedToId', ''), d.get('assignedById', ''), d.get('ownerRepId', '')];
      }
      allow read: if isMember();
      allow create: if isManagement()
        || (isMember() && request.resource.data.assignedById == request.auth.uid);
      allow update: if isManagement()
        || (isMember() && request.auth.uid in taskPeople(resource.data));
      allow delete: if isManagement()
        || (isMember() && resource.data.get('assignedById', resource.data.get('ownerRepId', '')) == request.auth.uid);
    }

    // Course outlines: same as quotations. Reps change their own, ones shared with them, or ones they're
    // asked to help on; Admin and Management can change any. Old outlines with no owner stay open.
    match /course_outlines/{outlineId} {
      function outlinePeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in outlinePeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in outlinePeople(resource.data)
                           || resource.data.get('taggedRepId', '') == request.auth.uid
                           || request.auth.uid in resource.data.get('sharedWithIds', [])
                           || (resource.data.get('ownerId', '') == '' && resource.data.get('creatorId', '') == '')));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in outlinePeople(resource.data));
    }

    // My home: each person saves only their own card choice.
    match /user_prefs/{memberId} {
      allow read, write: if isMember() && request.auth.uid == memberId;
    }

    // Clients: every team member can add and edit; only Management can delete.
    match /clients/{clientId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // KPI settings per person (template and targets): Management only.
    match /reps/{memberId} {
      allow read: if isMember();
      allow write: if isManagement();
    }

    // Typed-in weekly KPI numbers: your own, or Admin/Management for anyone.
    match /month_kpis/{key} {
      allow read: if isMember();
      allow create, update: if isStaff()
        || (isMember() && request.resource.data.repId == request.auth.uid);
      allow delete: if isStaff();
    }

    // Project P&L (2026-10-17): the SST amount Management types for a training. Management only.
    match /project_pl/{dealId} {
      allow read, write: if isManagement();
    }

    // All other CRM work data: team members only
    match /{coll}/{docId=**} {
      allow read, write: if isMember() && coll in [
        'admin_records', 'appointments', 'client_payments',
        'events', 'links', 'payments',
        'project_pls'
      ];
    }
  }
}
