rules_version = '2';

// NEXT Academy CRM database rules (Phase 3 + My home + shared quotations + deal deletion + client deletion + course outlines + trainer and venue deletion + to-do tasks + Google Calendar + follow-up rules, lost reasons and kept deleted deals)
// - The Team list is readable by the login screen; only the CRM server changes it.
// - Passwords live in 'secrets', which no browser can ever read.
// - Everything else requires a logged-in, active team member.
// - The old plain-text password store can no longer be read by anyone.
// - Outlook email (2026-10-18): team_emails is read by members and written only by the server; config/outlook
//   is server-only; the Microsoft client secret is in server_secrets, which no browser can read (no rule = no access).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myLinkPath() {
      return /databases/$(database)/documents/auth_map/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(myLinkPath()) && get(myLinkPath()).data.active == true;
    }
    function isManagement() {
      return isMember() && get(myLinkPath()).data.role == 'management';
    }
    function isStaff() {
      return isMember() && get(myLinkPath()).data.role in ['admin', 'management'];
    }
    function ownerOf(data) {
      return data.get('ownerId', data.get('creatorId', ''));
    }

    // People: names and roles (shown on the login screen).
    // Only the CRM server changes these, after checking Management's login.
    match /team/{memberId} {
      allow read: if true;
      allow write: if false;
    }

    // Links each login to a team member and role (used by these rules).
    match /auth_map/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManagement());
      allow write: if false;
    }

    // Work emails (the "From" address for Outlook): every member can read; only the CRM server writes (Management sets them in Team).
    match /team_emails/{memberId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Scrambled passwords: only the CRM server may touch these.
    match /secrets/{memberId} {
      allow read, write: if false;
    }

    // Settings. The admin checklist's master task list and money settings: Admin and Management only.
    // sales_target (the company sales target and its period) and follow_up_rules (follow-up checkpoints per stage): Management only.
    // link_settings (default time and open limits of client links, 2026-10-19): Management only.
    // google_calendar (the shared Google Calendar's ID and sync status), backup_settings (the backup Google Sheet
    // and last result) and outlook (the Microsoft 365 app's IDs) are written only by the CRM server.
    match /config/{docId} {
      allow read: if docId == 'setup' || (isMember() && docId != 'passwords');
      allow create, update: if (isMember() && !(docId in ['passwords', 'setup', 'checklist_tasks', 'money_settings', 'google_calendar', 'backup_settings', 'outlook', 'sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings']))
                            || (docId in ['checklist_tasks', 'money_settings'] && isStaff())
                            || (docId in ['sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings'] && isManagement());
      allow delete: if (docId in ['passwords', 'sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings'] && isManagement())
                    || (isMember() && !(docId in ['passwords', 'setup', 'checklist_tasks', 'money_settings', 'google_calendar', 'backup_settings', 'outlook', 'sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings']));
    }

    // Deals: reps change only their own; anyone asked to help may tick "done".
    // Lost (2026-10-18): a deal can only become lost with a reason and a short explanation (at least 10 characters).
    // Deleted (2026-10-18): "Delete deal" keeps the deal and marks it deleted. Only its creator or Management may
    // do that, never on a won deal except by Management (2026-10-20: "managers can delete anything at any time"), and everyone except Management must give a reason. Only Management restores
    // a deleted deal or changes it while it is deleted.
    match /pipelines/{dealId} {
      function wasDeleted() {
        return resource.data.get('deleted', false) == true;
      }
      function becomesDeleted() {
        return request.resource.data.get('deleted', false) == true;
      }
      function deleteChangeOk() {
        return (wasDeleted() == becomesDeleted() && (!wasDeleted() || isManagement()))
          || (becomesDeleted() && !wasDeleted()
              && (resource.data.get('stage', '') != 'won' || isManagement())
              && request.resource.data.get('deletedById', '') == request.auth.uid
              && (isManagement()
                  || (resource.data.get('creatorId', resource.data.get('ownerId', '')) == request.auth.uid
                      && request.resource.data.get('deletedReason', '') is string
                      && request.resource.data.get('deletedReason', '').size() >= 3)))
          || (wasDeleted() && !becomesDeleted() && isManagement());
      }
      function lostOk() {
        return request.resource.data.get('stage', '') != 'lost'
          || resource.data.get('stage', '') == 'lost'
          || (request.resource.data.get('lostReason', '') is string
              && request.resource.data.get('lostReason', '').size() > 0
              && request.resource.data.get('lostNote', '') is string
              && request.resource.data.get('lostNote', '').size() >= 10);
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.resource.data.ownerId == request.auth.uid);
      allow update: if deleteChangeOk() && lostOk() && (isStaff()
        || (isMember() && ownerOf(resource.data) == request.auth.uid)
        || (isMember()
            && request.auth.uid in resource.data.get('taggedRepIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedTags'])));
      // Delete: Management any deal at any time (2026-10-20); otherwise only the person who created it, never a won deal.
      allow delete: if isManagement()
        || (resource.data.get('stage', '') != 'won'
            && isMember() && resource.data.get('creatorId', resource.data.get('ownerId', '')) == request.auth.uid);
    }

    // Admin checklist per won deal (Phase 2B). Everyone can see progress.
    // The deal's owner may start it when marking the deal won; only Admin and
    // Management can tick, change or remove it.
    match /deal_checklists/{dealId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && ownerOf(get(/databases/$(database)/documents/pipelines/$(dealId)).data) == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // Programme list (Phase 2C). Anyone can add a new programme from a deal,
    // but only as "not registered"; only Admin and Management change its HRDC status.
    match /programmes/{programmeId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.resource.data.hrdcStatus == 'not_registered');
      allow update, delete: if isStaff();
    }

    // HRDC queries on a deal (Phase 2C): everyone sees them; Admin and Management handle them.
    match /hrdc_queries/{queryId} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Money in (Phase 3): HRDC claims and client invoices. Reps may see their
    // payment status; only Admin and Management record or change them.
    match /money_in/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Money out (Phase 3): payment requests. Admin and Management only.
    // - Raised as "pending" by the person requesting it.
    // - Approved or rejected only by a manager who did NOT raise it.
    // - Only approved items can be marked paid (and that can be undone).
    match /money_out/{id} {
      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedById == request.auth.uid;
      allow update: if isStaff() && (
        // approve or reject
        (isManagement()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && resource.data.requestedById != request.auth.uid
          && request.resource.data.decidedById == request.auth.uid
          && changedOnly(['status', 'decidedById', 'decidedByName', 'decidedAt', 'rejectReason']))
        // mark paid, or undo paid
        || (((resource.data.status == 'approved' && request.resource.data.status == 'paid')
             || (resource.data.status == 'paid' && request.resource.data.status == 'approved'))
          && changedOnly(['status', 'paidDate', 'paidRef', 'paidById', 'paidByName']))
        // hidden with (or brought back with) a deal Management deleted (2026-10-20)
        || (isManagement() && changedOnly(['dealDeleted']))
      );
      // Delete: Management any request at any time (2026-10-20); the requester only while pending or rejected.
      allow delete: if isManagement()
        || (isStaff() && resource.data.status in ['pending', 'rejected'] && resource.data.requestedById == request.auth.uid);
    }

    // Quotations: reps change their own, ones shared with them, or ones they're asked to help on;
    // Admin and Management can change any. Old shared templates with no owner stay open.
    match /quotations/{quoteId} {
      function quotePeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in quotePeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in quotePeople(resource.data)
                           || resource.data.get('taggedRepId', '') == request.auth.uid
                           || request.auth.uid in resource.data.get('sharedWithIds', [])
                           || (resource.data.get('ownerId', '') == '' && resource.data.get('creatorId', '') == '')));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in quotePeople(resource.data));
    }

    // Proposal files on deals (2026-10-18): the file is in Storage (storage.rules); this is its record.
    // Everyone reads; you add records only as yourself; only the uploader or Management deletes.
    match /proposal_files/{fileId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.byId == request.auth.uid;
      allow update: if false;
      allow delete: if isManagement() || (isMember() && resource.data.byId == request.auth.uid);
    }

    // Files on admin checklist steps (JD14, T3, Output assessment; 2026-10-19). The files are in Storage.
    // Everyone reads; Admin and Management upload as themselves; the uploader or Management deletes.
    match /checklist_files/{fileId} {
      allow read: if isMember();
      allow create: if isStaff() && request.resource.data.byId == request.auth.uid
                    && request.resource.data.dealId is string && request.resource.data.taskId is string;
      allow update: if false;
      allow delete: if isManagement() || (isStaff() && resource.data.byId == request.auth.uid);
    }

    // What the CRM has sent to the shared Google Calendar: only the CRM server uses this.
    match /calendar_sync/{id} {
      allow read, write: if false;
    }

    // Trainers: every team member can add and edit; only Management can delete.
    match /trainers_directory/{trainerId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // Venues: every team member can add and edit; only Management can delete.
    match /venues_directory/{venueId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // To-do tasks (2026-10-17): one shared task per job. Anyone adds a task as themselves; the person it's
    // assigned to and the person who assigned it can change it; only the assigner or Management can delete.
    // Older tasks may only have ownerRepId (whose list they sat in), so that counts too.
    match /tasks/{taskId} {
      function taskPeople(d) {
        return [d.get('assignedToId', ''), d.get('assignedById', ''), d.get('ownerRepId', '')];
      }
      allow read: if isMember();
      allow create: if isManagement()
        || (isMember() && request.resource.data.assignedById == request.auth.uid);
      // Several people (2026-10-18): anyone in assignedToIds may change it too.
      allow update: if isManagement()
        || (isMember() && (request.auth.uid in taskPeople(resource.data) || request.auth.uid in resource.data.get('assignedToIds', [])));
      allow delete: if isManagement()
        || (isMember() && resource.data.get('assignedById', resource.data.get('ownerRepId', '')) == request.auth.uid);
    }

    // Course outlines: same as quotations. Reps change their own, ones shared with them, or ones they're
    // asked to help on; Admin and Management can change any. Old outlines with no owner stay open.
    match /course_outlines/{outlineId} {
      function outlinePeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in outlinePeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in outlinePeople(resource.data)
                           || resource.data.get('taggedRepId', '') == request.auth.uid
                           || request.auth.uid in resource.data.get('sharedWithIds', [])
                           || (resource.data.get('ownerId', '') == '' && resource.data.get('creatorId', '') == '')));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in outlinePeople(resource.data));
    }

    // Teambuilding proposals (2026-10-19): the same rights as course outlines (own, shared with, tagged,
    // or Admin and Management edit any). A separate list, so course outlines are not affected.
    match /teambuilding_proposals/{proposalId} {
      function tbPeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in tbPeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in tbPeople(resource.data)
                           || request.auth.uid in resource.data.get('sharedWithIds', [])));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in tbPeople(resource.data));
    }

    // Teambuilding activity library (2026-10-19): everyone reads, adds and edits (Joel: "everyone can amend").
    // Delete only by the person who added it, or Management (anyone can "Stop using" it instead).
    match /tb_activities/{activityId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.get('createdById', '') == request.auth.uid;
      allow update: if isMember() && request.resource.data.get('createdById', '') == resource.data.get('createdById', '');
      allow delete: if isManagement()
        || (isMember() && resource.data.get('createdById', '') == request.auth.uid);
    }

    // Teambuilding settings (the standard package template): everyone reads and edits.
    match /tb_settings/{settingId} {
      allow read, write: if isMember();
    }

    // My home: each person saves only their own card choice.
    match /user_prefs/{memberId} {
      allow read, write: if isMember() && request.auth.uid == memberId;
    }

    // Clients: every team member can add and edit; only Management can delete.
    match /clients/{clientId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // Client touch points (2026-10-18): everyone reads; anyone adds one as themselves;
    // only the person who added it, or Management, changes or deletes it.
    match /client_touch_points/{tpId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.byId == request.auth.uid
        && request.resource.data.clientId is string && request.resource.data.clientId != ''
        && request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow update: if isManagement()
        || (isMember() && resource.data.byId == request.auth.uid && request.resource.data.byId == request.auth.uid);
      allow delete: if isManagement() || (isMember() && resource.data.byId == request.auth.uid);
    }

    // KPI settings per person (template and targets): Management only.
    match /reps/{memberId} {
      allow read: if isMember();
      allow write: if isManagement();
    }

    // Typed-in weekly KPI numbers: your own, or Admin/Management for anyone.
    match /month_kpis/{key} {
      allow read: if isMember();
      allow create, update: if isStaff()
        || (isMember() && request.resource.data.repId == request.auth.uid);
      allow delete: if isStaff();
    }

    // Project P&L (2026-10-17): the SST amount Management types for a training. Management only.
    match /project_pl/{dealId} {
      allow read, write: if isManagement();
    }

    // Trainer links (2026-10-17): private links for a trainer to fill in a course outline or their profile.
    // Team members make, cancel and accept them. Trainers never use the database: the CRM server reads the
    // link and stores what they submit (serverTrainerLinks.ts).
    match /trainer_links/{token} {
      allow read, create, update: if isMember();
      allow delete: if isStaff();
    }

    // Trainer IC / passport numbers (2026-10-20; Joel: only Admin and Management can see them).
    // trainer_private/{trainerId}: { icNumber, at, byName }. trainer_link_private/{token}: what a trainer typed on
    // their profile link, written only by the server (serverTrainerLinks.ts).
    match /trainer_private/{trainerId} {
      allow read, write: if isStaff();
    }
    match /trainer_link_private/{token} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Client links for quotations and course outlines (2026-10-19): members see them (and how often the client
    // opened them); only the server makes, stops and counts them (serverDocLinks.ts).
    match /doc_links/{token} {
      allow read: if isMember();
      allow write: if false;
    }

    // Teambuilding proposal visits (push B, 2026-10-19): written only by the server. Admin and Management read them;
    // reps only when Management has switched on "Reps can see proposal tracking" (config/proposal_settings).
    match /proposal_views/{visitId} {
      allow read: if isStaff()
        || (isMember() && exists(/databases/$(database)/documents/config/proposal_settings)
            && get(/databases/$(database)/documents/config/proposal_settings).data.get('repsSeeTracking', false) == true);
      allow write: if false;
    }

    // All other CRM work data: team members only
    match /{coll}/{docId=**} {
      allow read, write: if isMember() && coll in [
        'admin_records', 'appointments', 'client_payments',
        'events', 'links', 'payments',
        'project_pls'
      ];
    }
  }
}
