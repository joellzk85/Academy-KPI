rules_version = '2';

// NEXT Academy CRM database rules (Phase 3 + My home + shared quotations + deal deletion + client deletion + course outlines + trainer and venue deletion + to-do tasks + Google Calendar + follow-up rules, lost reasons and kept deleted deals)
// - The Team list is readable by the login screen; only the CRM server changes it.
// - Passwords live in 'secrets', which no browser can ever read.
// - Everything else requires a logged-in, active team member.
// - The old plain-text password store can no longer be read by anyone.
// - Outlook email (2026-10-18): team_emails is read by members and written only by the server; config/outlook
//   is server-only; the Microsoft client secret is in server_secrets, which no browser can read (no rule = no access).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myLinkPath() {
      return /databases/$(database)/documents/auth_map/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(myLinkPath()) && get(myLinkPath()).data.active == true;
    }
    function isManagement() {
      return isMember() && get(myLinkPath()).data.role == 'management';
    }
    function isStaff() {
      return isMember() && get(myLinkPath()).data.role in ['admin', 'management'];
    }
    function ownerOf(data) {
      return data.get('ownerId', data.get('creatorId', ''));
    }

    // Month lock (2026-10-22, src/lib/monthLock.ts): a month 'YYYY-MM' locks at the 1st of the next month 00:00 UTC
    // + 40 hours (= 00:00 Malaysia time on the 3rd). After that only Management adds or changes things dated in it,
    // unless Management reopened it (config/month_locks.open).
    function lockMomentOf(y, m) {
      return (m == 12 ? timestamp.date(y + 1, 1, 1) : timestamp.date(y, m + 1, 1)) + duration.value(40, 'h');
    }
    function monthOpen(ym) {
      return ym is string && ym.matches('[0-9]{4}-[0-9]{2}')
        && (request.time < lockMomentOf(int(ym.split('-')[0]), int(ym.split('-')[1]))
            || (exists(/databases/$(database)/documents/config/month_locks)
                && ym in get(/databases/$(database)/documents/config/month_locks).data.get('open', [])));
    }
    // A date 'YYYY-MM-DD…' in an open month (or no usable date: nothing to lock).
    function dateOpen(d) {
      return !(d is string && d.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}.*')) || monthOpen(d.split('-')[0] + '-' + d.split('-')[1]);
    }

    // People: names and roles (shown on the login screen).
    // Only the CRM server changes these, after checking Management's login.
    match /team/{memberId} {
      allow read: if true;
      allow write: if false;
    }

    // Links each login to a team member and role (used by these rules).
    match /auth_map/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManagement());
      allow write: if false;
    }

    // Work emails (the "From" address for Outlook): every member can read; only the CRM server writes (Management sets them in Team).
    match /team_emails/{memberId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Scrambled passwords: only the CRM server may touch these.
    match /secrets/{memberId} {
      allow read, write: if false;
    }

    // Settings. The admin checklist's master task list and money settings: Admin and Management only.
    // sales_target (the company sales target and its period) and follow_up_rules (follow-up checkpoints per stage): Management only.
    // link_settings (default time and open limits of client links, 2026-10-19): Management only.
    // google_calendar (the shared Google Calendar's ID and sync status), backup_settings (the backup Google Sheet
    // and last result) and outlook (the Microsoft 365 app's IDs) are written only by the CRM server.
    match /config/{docId} {
      allow read: if docId == 'setup' || (isMember() && docId != 'passwords');
      // trainer_overview (2026-10-21): who else may open Trainers → Overview; Management only.
      // forecast_settings (2026-10-21): Hot / Warm / Cold chances for the sales projection; Management only.
      // login_rules (2026-10-22): green / amber / red rules of Team → Login log; Management only.
      // kpi_library (2026-10-22): the KPI library, colour points and company GP bands (Team → KPI library); Management only.
      // rating_items (2026-10-22): the 360 attitude items; reliability: the appraisal's reliability score settings. Management only.
      // month_locks (2026-10-22): months Management reopened (Deal checks → Month lock); Management only.
      allow create, update: if (isMember() && !(docId in ['passwords', 'setup', 'checklist_tasks', 'money_settings', 'google_calendar', 'backup_settings', 'outlook', 'sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings', 'trainer_overview', 'forecast_settings', 'login_rules', 'kpi_library', 'month_locks', 'rating_items', 'reliability']))
                            || (docId in ['checklist_tasks', 'money_settings'] && isStaff())
                            || (docId in ['sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings', 'trainer_overview', 'forecast_settings', 'login_rules', 'kpi_library', 'month_locks', 'rating_items', 'reliability'] && isManagement());
      allow delete: if (docId in ['passwords', 'sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings', 'trainer_overview', 'forecast_settings', 'login_rules', 'kpi_library', 'month_locks', 'rating_items', 'reliability'] && isManagement())
                    || (isMember() && !(docId in ['passwords', 'setup', 'checklist_tasks', 'money_settings', 'google_calendar', 'backup_settings', 'outlook', 'sales_target', 'follow_up_rules', 'client_contact_colours', 'proposal_settings', 'link_settings', 'trainer_overview', 'forecast_settings', 'login_rules', 'kpi_library', 'month_locks', 'rating_items', 'reliability']));
    }

    // Deals: reps change only their own; anyone asked to help may tick "done".
    // Lost (2026-10-18): a deal can only become lost with a reason and a short explanation (at least 10 characters).
    // Deleted (2026-10-18): "Delete deal" keeps the deal and marks it deleted. Only its creator or Management may
    // do that, never on a won deal except by Management (2026-10-20: "managers can delete anything at any time"), and everyone except Management must give a reason. Only Management restores
    // a deleted deal or changes it while it is deleted.
    match /pipelines/{dealId} {
      function wasDeleted() {
        return resource.data.get('deleted', false) == true;
      }
      function becomesDeleted() {
        return request.resource.data.get('deleted', false) == true;
      }
      function deleteChangeOk() {
        return (wasDeleted() == becomesDeleted() && (!wasDeleted() || isManagement()))
          || (becomesDeleted() && !wasDeleted()
              && (resource.data.get('stage', '') != 'won' || isManagement())
              && request.resource.data.get('deletedById', '') == request.auth.uid
              && (isManagement()
                  || (resource.data.get('creatorId', resource.data.get('ownerId', '')) == request.auth.uid
                      && request.resource.data.get('deletedReason', '') is string
                      && request.resource.data.get('deletedReason', '').size() >= 3)))
          || (wasDeleted() && !becomesDeleted() && isManagement());
      }
      function lostOk() {
        return request.resource.data.get('stage', '') != 'lost'
          || resource.data.get('stage', '') == 'lost'
          || (request.resource.data.get('lostReason', '') is string
              && request.resource.data.get('lostReason', '').size() > 0
              && request.resource.data.get('lostNote', '') is string
              && request.resource.data.get('lostNote', '').size() >= 10);
      }
      // Change date / Cancel training (2026-10-21): once a won deal has a training date, the date and days only
      // change, and the deal only becomes lost, when a manager approves a pending request someone else made
      // (trainingChange), in the same write.
      function hadDate() {
        return resource.data.get('trainingDate', '') is string
          && resource.data.get('trainingDate', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}.*');
      }
      function changeApproved(kind) {
        return isManagement()
          && resource.data.get('trainingChange', {}).get('status', '') == 'pending'
          && resource.data.get('trainingChange', {}).get('kind', '') == kind
          && resource.data.get('trainingChange', {}).get('byId', '') != request.auth.uid
          && request.resource.data.get('trainingChange', {}).get('status', '') == 'approved'
          && request.resource.data.get('trainingChange', {}).get('decidedById', '') == request.auth.uid;
      }
      // KPI integrity (2026-10-22). Won date: within 36 hours of now (no backdating), unless Management sets it.
      function wonDateOk(d) {
        return isManagement()
          || (d.get('wonDate', '') is string && d.get('wonDate', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && request.time > timestamp.date(int(d.wonDate.split('-')[0]), int(d.wonDate.split('-')[1]), int(d.wonDate.split('-')[2])) - duration.value(36, 'h')
              && request.time < timestamp.date(int(d.wonDate.split('-')[0]), int(d.wonDate.split('-')[1]), int(d.wonDate.split('-')[2])) + duration.value(36, 'h'));
      }
      function becomesWon() {
        return request.resource.data.get('stage', '') == 'won' && resource.data.get('stage', '') != 'won';
      }
      function same(k) {
        return request.resource.data.get(k, null) == resource.data.get(k, null);
      }
      // A won deal keeps its value, participants, programme and funding type; value and pax change only when a
      // manager approves a pending "Change value / pax" request, to the value asked.
      function wonLockOk() {
        return !(resource.data.get('stage', '') == 'won' && request.resource.data.get('stage', '') == 'won')
          || (same('programmeId') && same('courseName') && same('fundingType')
              && ((same('proposalValue') && same('participants'))
                  || (changeApproved('value')
                      && request.resource.data.get('proposalValue', null) == resource.data.trainingChange.get('newValue', -1))));
      }
      function integrityOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (!(becomesWon() || (request.resource.data.get('stage', '') == 'won' && changed.hasAny(['wonDate']))) || wonDateOk(request.resource.data))
          && wonLockOk()
          && (!changed.hasAny(['integrityChecks', 'dateChangeCount', 'firstTrainingDate', 'valueChanges']) || isManagement())
          && (!changed.hasAny(['wonOriginal']) || isManagement() || becomesWon())
          && request.resource.data.get('winCount', 0) >= resource.data.get('winCount', 0);
      }
      // Month lock: a changed meeting date (old and new) and a newly added follow-up note must be in open months.
      function lockOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let notes = request.resource.data.get('followUps', []);
        let before = resource.data.get('followUps', []);
        return isManagement()
          || ((!changed.hasAny(['appointmentDate'])
               || (dateOpen(request.resource.data.get('appointmentDate', '')) && dateOpen(resource.data.get('appointmentDate', ''))))
              && (!changed.hasAny(['followUps']) || !(notes is list) || notes.size() == 0
                  || (before is list && before.size() > 0 && notes[notes.size() - 1] == before[before.size() - 1])
                  || dateOpen(notes[notes.size() - 1].get('date', ''))));
      }
      function trainingChangeOk() {
        return resource.data.get('stage', '') != 'won'
          || (request.resource.data.get('stage', '') == 'lost' && changeApproved('cancel'))
          || (request.resource.data.get('stage', '') != 'lost'
              && (!hadDate()
                  || (request.resource.data.get('trainingDate', '') == resource.data.get('trainingDate', '')
                      && request.resource.data.get('trainingDays', 1) == resource.data.get('trainingDays', 1))
                  || (changeApproved('date')
                      && request.resource.data.get('trainingDate', '') == resource.data.trainingChange.get('newDate', ''))));
      }
      allow read: if isMember();
      allow create: if (request.resource.data.get('stage', '') != 'won' || wonDateOk(request.resource.data))
        && (isStaff()
            || (isMember() && request.resource.data.ownerId == request.auth.uid));
      allow update: if deleteChangeOk() && lostOk() && trainingChangeOk() && integrityOk() && lockOk() && (isStaff()
        || (isMember() && ownerOf(resource.data) == request.auth.uid)
        || (isMember()
            && request.auth.uid in resource.data.get('taggedRepIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedTags'])));
      // Delete: Management any deal at any time (2026-10-20); otherwise only the person who created it, never a won deal.
      allow delete: if isManagement()
        || (resource.data.get('stage', '') != 'won'
            && isMember() && resource.data.get('creatorId', resource.data.get('ownerId', '')) == request.auth.uid);
    }

    // Admin checklist per won deal (Phase 2B). Everyone can see progress.
    // The deal's owner may start it when marking the deal won; only Admin and
    // Management can tick, change or remove it.
    match /deal_checklists/{dealId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && ownerOf(get(/databases/$(database)/documents/pipelines/$(dealId)).data) == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // Programme list (Phase 2C). Anyone can add a new programme from a deal,
    // but only as "not registered"; only Admin and Management change its HRDC status.
    match /programmes/{programmeId} {
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.resource.data.hrdcStatus == 'not_registered');
      allow update, delete: if isStaff();
    }

    // HRDC queries on a deal (Phase 2C): everyone sees them; Admin and Management handle them.
    match /hrdc_queries/{queryId} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Money in (Phase 3): HRDC claims and client invoices. Reps may see their
    // payment status; only Admin and Management record or change them.
    match /money_in/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Money out (Phase 3): payment requests. Admin and Management only.
    // - Raised as "pending" by the person requesting it.
    // - Approved or rejected only by a manager who did NOT raise it.
    // - Only approved items can be marked paid (and that can be undone).
    match /money_out/{id} {
      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedById == request.auth.uid;
      allow update: if isStaff() && (
        // approve or reject
        (isManagement()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && resource.data.requestedById != request.auth.uid
          && request.resource.data.decidedById == request.auth.uid
          && changedOnly(['status', 'decidedById', 'decidedByName', 'decidedAt', 'rejectReason']))
        // mark paid, or undo paid
        || (((resource.data.status == 'approved' && request.resource.data.status == 'paid')
             || (resource.data.status == 'paid' && request.resource.data.status == 'approved'))
          && changedOnly(['status', 'paidDate', 'paidRef', 'paidById', 'paidByName']))
        // stopped when Management approves a training cancellation (2026-10-21): pending or approved, not paid
        || (isManagement()
          && resource.data.status in ['pending', 'approved']
          && request.resource.data.status == 'rejected'
          && request.resource.data.get('trainingCancelled', false) == true
          && request.resource.data.decidedById == request.auth.uid
          && changedOnly(['status', 'trainingCancelled', 'decidedById', 'decidedByName', 'decidedAt', 'rejectReason']))
        // hidden with (or brought back with) a deal Management deleted (2026-10-20)
        || (isManagement() && changedOnly(['dealDeleted']))
        // "Include in P&L" tick (2026-10-21) and "Pay on behalf of client" tick (2026-10-22): Admin or Management, at any status
        || changedOnly(['inPL', 'onBehalf'])
        // Fix and send again (2026-10-21): the person who raised a rejected request fixes it; it waits for approval again
        || (resource.data.status == 'rejected'
          && resource.data.get('trainingCancelled', false) != true
          && resource.data.requestedById == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedById == request.auth.uid
          && request.resource.data.decidedById == ''
          && changedOnly(['status', 'amount', 'description', 'decidedById', 'decidedByName', 'decidedAt', 'rejectReason', 'resubmittedAt',
                          'category', 'payee', 'vendorId', 'requestDate', 'items', 'neededBy', 'paymentDetails']))
      );
      // Delete: Management any request at any time (2026-10-20); the requester only while pending or rejected.
      allow delete: if isManagement()
        || (isStaff() && resource.data.status in ['pending', 'rejected'] && resource.data.requestedById == request.auth.uid);
    }

    // Paid on behalf of the client (2026-10-22): reimbursement invoices to the client for costs we paid on their
    // behalf (money_out ticked onBehalf), and the client's payment back. Admin and Management only, like money_out.
    match /claim_backs/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isManagement() || (isStaff() && resource.data.get('paidDate', '') == '');
    }

    // Quotations: reps change their own, ones shared with them, or ones they're asked to help on;
    // Admin and Management can change any. Old shared templates with no owner stay open.
    match /quotations/{quoteId} {
      function quotePeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in quotePeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in quotePeople(resource.data)
                           || resource.data.get('taggedRepId', '') == request.auth.uid
                           || request.auth.uid in resource.data.get('sharedWithIds', [])
                           || (resource.data.get('ownerId', '') == '' && resource.data.get('creatorId', '') == '')));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in quotePeople(resource.data));
    }

    // Proposal files on deals (2026-10-18): the file is in Storage (storage.rules); this is its record.
    // Everyone reads; you add records only as yourself; only the uploader or Management deletes.
    match /proposal_files/{fileId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.byId == request.auth.uid;
      allow update: if false;
      allow delete: if isManagement() || (isMember() && resource.data.byId == request.auth.uid);
    }

    // Files on admin checklist steps (JD14, T3, Output assessment; 2026-10-19). The files are in Storage.
    // Everyone reads; Admin and Management upload as themselves; the uploader or Management deletes.
    match /checklist_files/{fileId} {
      allow read: if isMember();
      allow create: if isStaff() && request.resource.data.byId == request.auth.uid
                    && request.resource.data.dealId is string && request.resource.data.taskId is string;
      allow update: if false;
      allow delete: if isManagement() || (isStaff() && resource.data.byId == request.auth.uid);
    }

    // What the CRM has sent to the shared Google Calendar: only the CRM server uses this.
    match /calendar_sync/{id} {
      allow read, write: if false;
    }

    // Trainers: every team member can add and edit; only Management can delete.
    match /trainers_directory/{trainerId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // Venues: every team member can add and edit; only Management can delete.
    match /venues_directory/{venueId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // To-do tasks (2026-10-17): one shared task per job. Anyone adds a task as themselves; the person it's
    // assigned to and the person who assigned it can change it; only the assigner or Management can delete.
    // Older tasks may only have ownerRepId (whose list they sat in), so that counts too.
    match /tasks/{taskId} {
      function taskPeople(d) {
        return [d.get('assignedToId', ''), d.get('assignedById', ''), d.get('ownerRepId', '')];
      }
      allow read: if isMember();
      allow create: if isManagement()
        || (isMember() && request.resource.data.assignedById == request.auth.uid);
      // Several people (2026-10-18): anyone in assignedToIds may change it too.
      allow update: if isManagement()
        || (isMember() && (request.auth.uid in taskPeople(resource.data) || request.auth.uid in resource.data.get('assignedToIds', [])));
      allow delete: if isManagement()
        || (isMember() && resource.data.get('assignedById', resource.data.get('ownerRepId', '')) == request.auth.uid);
    }

    // Course outlines: same as quotations. Reps change their own, ones shared with them, or ones they're
    // asked to help on; Admin and Management can change any. Old outlines with no owner stay open.
    match /course_outlines/{outlineId} {
      function outlinePeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in outlinePeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in outlinePeople(resource.data)
                           || resource.data.get('taggedRepId', '') == request.auth.uid
                           || request.auth.uid in resource.data.get('sharedWithIds', [])
                           || (resource.data.get('ownerId', '') == '' && resource.data.get('creatorId', '') == '')));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in outlinePeople(resource.data));
    }

    // Teambuilding proposals (2026-10-19): the same rights as course outlines (own, shared with, tagged,
    // or Admin and Management edit any). A separate list, so course outlines are not affected.
    match /teambuilding_proposals/{proposalId} {
      function tbPeople(d) {
        return [d.get('ownerId', ''), d.get('creatorId', '')];
      }
      allow read: if isMember();
      allow create: if isStaff()
        || (isMember() && request.auth.uid in tbPeople(request.resource.data));
      allow update: if isStaff()
        || (isMember() && (request.auth.uid in tbPeople(resource.data)
                           || request.auth.uid in resource.data.get('sharedWithIds', [])));
      allow delete: if isStaff()
        || (isMember() && request.auth.uid in tbPeople(resource.data));
    }

    // Teambuilding activity library (2026-10-19): everyone reads, adds and edits (Joel: "everyone can amend").
    // Delete only by the person who added it, or Management (anyone can "Stop using" it instead).
    // Approval (2026-10-22): a new activity starts pending (or, from older screens, with no approval). Only Management,
    // never the one who added it, sets approved or not approved (signed with their own id). The creator's change to a
    // not-approved activity may only send it back to pending. Any other change keeps the approval as it was.
    match /tb_activities/{activityId} {
      function approvalOf(d) { return d.get('approval', null); }
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.get('createdById', '') == request.auth.uid
        && (approvalOf(request.resource.data) == null || approvalOf(request.resource.data) == {'status': 'pending'});
      allow update: if isMember() && request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
        && (approvalOf(request.resource.data) == approvalOf(resource.data)
          || (isManagement() && approvalOf(resource.data) != null
              && resource.data.get('createdById', '') != request.auth.uid
              && approvalOf(request.resource.data).get('status', '') in ['approved', 'rejected']
              && approvalOf(request.resource.data).get('byId', '') == request.auth.uid)
          || (approvalOf(resource.data) != null && approvalOf(resource.data).get('status', '') == 'rejected'
              && resource.data.get('createdById', '') == request.auth.uid
              && approvalOf(request.resource.data) == {'status': 'pending'}));
      allow delete: if isManagement()
        || (isMember() && resource.data.get('createdById', '') == request.auth.uid);
    }

    // Teambuilding settings (the standard package template): everyone reads and edits.
    match /tb_settings/{settingId} {
      allow read, write: if isMember();
    }

    // My home: each person saves only their own card choice.
    match /user_prefs/{memberId} {
      allow read, write: if isMember() && request.auth.uid == memberId;
    }

    // Weekly presentation (2026-10-21): each person's chosen slides and period. The team can read them
    // (Management's team meeting plays each person's own choice); only the person saves their own.
    match /present_prefs/{memberId} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == memberId;
    }

    // Team meeting (2026-10-21): the set-up (title, question for the week, company look) and the notes typed
    // during each meeting. The team reads; Management and Admin write.
    match /present_settings/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }
    match /meeting_notes/{date} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Costing estimator (2026-10-21): each person's mock P&Ls. The owner and Admin/Management read, edit and delete;
    // a new one must be owned by whoever creates it.
    match /cost_estimates/{estimateId} {
      allow read, update, delete: if isStaff() || (isMember() && resource.data.ownerId == request.auth.uid);
      allow create: if isMember() && request.resource.data.ownerId == request.auth.uid;
    }

    // Clients: every team member can add and edit; only Management can delete.
    match /clients/{clientId} {
      allow read, create, update: if isMember();
      allow delete: if isManagement();
    }

    // Client touch points (2026-10-18): everyone reads; anyone adds one as themselves;
    // only the person who added it, or Management, changes or deletes it.
    match /client_touch_points/{tpId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.byId == request.auth.uid
        && request.resource.data.clientId is string && request.resource.data.clientId != ''
        && request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow update: if isManagement()
        || (isMember() && resource.data.byId == request.auth.uid && request.resource.data.byId == request.auth.uid);
      allow delete: if isManagement() || (isMember() && resource.data.byId == request.auth.uid);
    }

    // 360 rating (2026-10-22, src/lib/rating360.ts). Rounds: everyone reads, Management sets up and closes.
    match /rating_rounds/{roundId} {
      allow read: if isMember();
      allow write: if isManagement();
    }

    // Ratings: only the rater and Management read them (the person rated gets theirs from the server, without names
    // unless the round is open view). You rate only the people the open round gives you, never yourself.
    // Since 2026-10-22 a rating has stars per attitude item (items: { itemId: 1-5 }) with reasons for scores of 1 or 2
    // (comments, checked by the CRM; the rules can't look inside each item) and an optional general comment. Older
    // ratings: 1-5 stars, always with a reason of at least 20 characters. Document id = <roundId>_<raterId>_<rateeId>.
    match /ratings_360/{ratingId} {
      function roundOf(d) { return get(/databases/$(database)/documents/rating_rounds/$(d.roundId)).data; }
      function assigned(d) {
        return roundOf(d).get('mode', 'all') == 'picked'
          ? {'raterId': request.auth.uid, 'rateeId': d.rateeId} in roundOf(d).get('pairs', [])
          : request.auth.uid in roundOf(d).get('people', []) && d.rateeId in roundOf(d).get('people', []);
      }
      function validRating(d) {
        return d.raterId == request.auth.uid && d.rateeId is string && d.rateeId != request.auth.uid
          && ratingId == d.roundId + '_' + request.auth.uid + '_' + d.rateeId
          && ((d.stars is int && d.stars >= 1 && d.stars <= 5 && d.comment is string && d.comment.size() >= 20)
              || (!('stars' in d) && d.items is map && d.items.size() > 0 && d.items.size() <= 30
                  && d.get('comments', {}) is map && d.get('comment', '') is string))
          && exists(/databases/$(database)/documents/rating_rounds/$(d.roundId))
          && roundOf(d).get('status', '') == 'open' && assigned(d);
      }
      allow read: if isManagement() || (isMember() && resource.data.raterId == request.auth.uid);
      allow create: if isMember() && validRating(request.resource.data);
      allow update: if isMember() && resource.data.raterId == request.auth.uid && validRating(request.resource.data);
      allow delete: if isManagement();
    }

    // Appraisal (2026-10-22, src/lib/reliability.ts, components/Appraisal.tsx).
    // Days out of office: Admin and Management note and read them. Incidents and appraisal notes: Management only.
    match /reliability_excused/{dayId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.memberId is string && request.resource.data.date is string
        && dayId == request.resource.data.memberId + '_' + request.resource.data.date;
    }
    match /reliability_incidents/{incidentId} {
      allow read, write: if isManagement();
    }
    match /appraisal_notes/{noteId} {
      allow read, write: if isManagement();
    }

    // KPI settings per person (template and targets): Management only.
    match /reps/{memberId} {
      allow read: if isMember();
      allow write: if isManagement();
    }

    // Typed-in weekly KPI numbers: your own, or Admin/Management for anyone.
    // Month lock (2026-10-22): only in an open month (month 'OCT-26', matching the key), unless Management.
    match /month_kpis/{key} {
      function kpiYm(month) {
        let parts = month.split('-');
        let nums = {'JAN': '01', 'FEB': '02', 'MAR': '03', 'APR': '04', 'MAY': '05', 'JUN': '06', 'JUL': '07', 'AUG': '08', 'SEP': '09', 'OCT': '10', 'NOV': '11', 'DEC': '12'};
        return '20' + parts[1] + '-' + nums.get(parts[0], '00');
      }
      function kpiMonthOpen() {
        let month = request.resource.data.get('month', '');
        return month is string && month.matches('[A-Z]{3}-[0-9]{2}') && key.matches('.*_' + month)
          && monthOpen(kpiYm(month))
          && (resource == null || resource.data.get('month', '') == month);
      }
      allow read: if isMember();
      allow create, update: if isManagement()
        || (kpiMonthOpen() && (isStaff()
            || (isMember() && request.resource.data.repId == request.auth.uid)));
      allow delete: if isStaff();
    }

    // Project P&L (2026-10-17): the SST amount Management types for a training. Management writes; Admin reads it
    // (2026-10-21) so the deal's "Money out and P&L" shows the same profit as Project P&L.
    match /project_pl/{dealId} {
      allow read: if isStaff();
      allow write: if isManagement();
    }

    // Payment tracking (2026-10-20): HRDC claim and invoice lines imported from the Blueprint spreadsheet
    // ("Sales 2026") or added by hand. Management adds, edits and deletes. Admin (2026-10-20) reads them and may
    // change only the paid fields (mark paid / undo), from Admin work → Payment tracking.
    match /payment_records/{recordId} {
      allow read: if isStaff();
      allow create, delete: if isManagement();
      allow update: if isManagement() || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['paidDate', 'paidNote', 'paidAmount', 'updatedAt', 'updatedById', 'updatedByName']));
    }

    // Payment receipts from the client or HRDC (2026-10-20): on a deal's invoice or claim (money_in) or on a
    // Payment tracking line. Admin and Management upload and read; delete by the uploader or Management.
    // The files are in Storage receipts/... (storage.rules).
    // Vendors (2026-10-20): who we pay for trainings, with bank details for accounts. Admin and Management only
    // (bank account numbers); delete by Management. Payment summaries for accounts read them on the server.
    match /vendors/{vendorId} {
      allow read, create, update: if isStaff();
      allow delete: if isManagement();
    }

    match /payment_receipts/{receiptId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.byId == request.auth.uid && request.resource.data.path is string;
      allow update: if false;
      allow delete: if isManagement() || (isStaff() && resource.data.byId == request.auth.uid);
    }

    // Trainer links (2026-10-17): private links for a trainer to fill in a course outline or their profile.
    // Team members make, cancel and accept them. Trainers never use the database: the CRM server reads the
    // link and stores what they submit (serverTrainerLinks.ts).
    match /trainer_links/{token} {
      allow read, create, update: if isMember();
      allow delete: if isStaff();
    }

    // Trainer IC / passport numbers (2026-10-20; Joel: only Admin and Management can see them).
    // trainer_private/{trainerId}: { icNumber, at, byName }. trainer_link_private/{token}: what a trainer typed on
    // their profile link, written only by the server (serverTrainerLinks.ts).
    match /trainer_private/{trainerId} {
      allow read, write: if isStaff();
    }
    match /trainer_link_private/{token} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Trainer portal (2026-10-21). Trainers log in by email, but their logins have no auth_map record, so none of
    // these rules let them in: the portal goes only through the CRM server (serverTrainerPortal.ts).
    // trainer_accounts: who has portal access (written only by the server). trainer_jobs: one per trainer per
    // training (rating, PO accepted, fee request); Admin and Management write. trainer_bank_requests: a bank
    // account typed by a trainer, written by the server, accepted or rejected by Admin and Management.
    match /trainer_accounts/{trainerId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /trainer_jobs/{jobId} {
      allow read: if isMember();
      allow create, update: if isStaff();
      allow delete: if isManagement();
    }
    // Trainers' own course outlines and teambuilding proposals (2026-10-21; src/lib/trainerDocs.ts): written only by
    // the server from the trainer portal; the team reads them and makes its own copy ("Use for a deal").
    match /trainer_docs/{docId} {
      allow read: if isMember();
      allow write: if false;
    }
    // Training reports (2026-10-21), one per deal: the trainer writes theirs through the CRM server (portal);
    // Admin and Management read, fix, check or write it. Only Management changes what HR sees (showToHr).
    match /training_reports/{dealId} {
      allow read: if isMember();
      allow create: if isStaff() && (!('showToHr' in request.resource.data) || isManagement());
      allow update: if isStaff()
        && (request.resource.data.get('showToHr', {}) == resource.data.get('showToHr', {}) || isManagement());
      allow delete: if isManagement();
    }
    // Invite links to the trainer portal (/trainer/join/<token>): Admin and Management make and cancel them; the
    // trainer's side (open, accept) goes only through the CRM server.
    match /portal_invites/{token} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'open' && request.resource.data.createdById == request.auth.uid;
    }
    match /trainer_bank_requests/{trainerId} {
      allow read, update, delete: if isStaff();
      allow create: if false;
    }

    // Client links for quotations and course outlines (2026-10-19): members see them (and how often the client
    // opened them); only the server makes, stops and counts them (serverDocLinks.ts).
    match /doc_links/{token} {
      allow read: if isMember();
      allow write: if false;
    }

    // Client link visits (teambuilding push B 2026-10-19; every link kind since 2026-10-20): written only by the server.
    // Only Management reads them, plus the people Management ticked (config/proposal_settings.allowedIds), and those
    // only for visits on their own deals (ownerId).
    match /proposal_views/{visitId} {
      allow read: if isManagement()
        || (isMember() && resource.data.get('ownerId', '') == request.auth.uid
            && exists(/databases/$(database)/documents/config/proposal_settings)
            && request.auth.uid in get(/databases/$(database)/documents/config/proposal_settings).data.get('allowedIds', []));
      allow write: if false;
    }

    // Login history (2026-10-22), one document per person per day: "<memberId>_<YYYY-MM-DD>".
    // Each person writes only their own: the CRM adds one active minute at a time (at most once every 50 seconds)
    // or counts one more opening. Nobody can change a day's date, person or first time. Only Management reads them.
    // Since 2026-10-22 also: actions (work saved; up to 20 added at a time, at most every 10 seconds) and places
    // (minutes per screen; each new minute adds 1 to exactly one screen, named in place).
    match /login_days/{dayId} {
      function placeOk(d) {
        return d.place is string && d.place.matches('^[A-Za-z0-9_]{1,40}$') && d.places is map && d.places.size() <= 60;
      }
      allow read: if isManagement();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['memberId', 'date', 'minutes', 'logins', 'firstAt', 'lastAt', 'actions', 'lastActionAt', 'places', 'place'])
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.date is string
        && dayId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.minutes in [0, 1]
        && request.resource.data.logins in [0, 1]
        && request.resource.data.get('actions', 0) is int
        && request.resource.data.get('actions', 0) >= 0 && request.resource.data.get('actions', 0) <= 20
        && (!('lastActionAt' in request.resource.data) || request.resource.data.lastActionAt == request.time)
        && (request.resource.data.get('places', {}).size() == 0
            || (placeOk(request.resource.data) && request.resource.data.minutes == 1
                && request.resource.data.places.keys().hasOnly([request.resource.data.place])
                && request.resource.data.places[request.resource.data.place] == 1))
        && request.resource.data.firstAt == request.time
        && request.resource.data.lastAt == request.time;
      allow update: if isMember()
        && resource.data.memberId == request.auth.uid
        && (
          // opened the CRM once more
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logins', 'lastAt'])
            && request.resource.data.lastAt == request.time
            && request.resource.data.logins == resource.data.logins + 1)
          // one more active minute, on one screen (older CRM versions send no screen)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minutes', 'lastAt', 'places', 'place'])
            && request.resource.data.lastAt == request.time
            && request.resource.data.minutes == resource.data.minutes + 1
            && request.time > resource.data.lastAt + duration.value(50, 's')
            && (request.resource.data.get('places', {}) == resource.data.get('places', {})
                || (placeOk(request.resource.data)
                    && request.resource.data.places.diff(resource.data.get('places', {})).affectedKeys().hasOnly([request.resource.data.place])
                    && request.resource.data.places[request.resource.data.place] == resource.data.get('places', {}).get(request.resource.data.place, 0) + 1)))
          // work saved
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions', 'lastActionAt'])
            && request.resource.data.lastActionAt == request.time
            && request.resource.data.actions is int
            && request.resource.data.actions > resource.data.get('actions', 0)
            && request.resource.data.actions <= resource.data.get('actions', 0) + 20
            && (!('lastActionAt' in resource.data) || request.time > resource.data.lastActionAt + duration.value(10, 's')))
        );
      allow delete: if false;
    }

    // All other CRM work data: team members only
    match /{coll}/{docId=**} {
      allow read, write: if isMember() && coll in [
        'admin_records', 'appointments', 'client_payments',
        'events', 'links', 'payments',
        'project_pls'
      ];
    }
  }
}
