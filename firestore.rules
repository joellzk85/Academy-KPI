rules_version = '2';

// NEXT Academy CRM database rules (Phase 1)
// - The Team list is readable by the login screen, but only Management can change it.
// - Everything else requires a logged-in, active team member.
// - The old plain-text password store can no longer be read by anyone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myLinkPath() {
      return /databases/$(database)/documents/auth_map/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(myLinkPath()) && get(myLinkPath()).data.active == true;
    }
    function isManagement() {
      return isMember() && get(myLinkPath()).data.role == 'management';
    }
    function setupDone() {
      return exists(/databases/$(database)/documents/config/setup);
    }

    // People: names and roles (shown on the login screen)
    match /team/{memberId} {
      allow read: if true;
      allow create: if isManagement()
        || (signedIn() && !setupDone()
            && request.resource.data.role == 'management'
            && request.resource.data.authUid == request.auth.uid);
      // Management can edit anyone; a person may only mark their own
      // temporary password as changed.
      allow update: if isManagement()
        || (isMember()
            && resource.data.authUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);
      allow delete: if isManagement();
    }

    // Links each login to a team member and role (used by these rules)
    match /auth_map/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManagement());
      allow create: if isManagement()
        || (signedIn() && !setupDone()
            && request.auth.uid == uid
            && request.resource.data.role == 'management');
      allow update, delete: if isManagement();
    }

    // Settings
    match /config/{docId} {
      allow read: if docId == 'setup' || (isMember() && docId != 'passwords');
      allow create: if (docId == 'setup' && signedIn() && !setupDone()
                         && existsAfter(/databases/$(database)/documents/auth_map/$(request.auth.uid)))
                    || (isMember() && docId != 'passwords' && docId != 'setup');
      allow update: if isMember() && docId != 'passwords' && docId != 'setup';
      allow delete: if (docId == 'passwords' && isManagement())
                    || (isMember() && docId != 'passwords' && docId != 'setup');
    }

    // All CRM work data: team members only
    match /{coll}/{docId=**} {
      allow read, write: if isMember() && coll in [
        'admin_records', 'appointments', 'client_payments', 'clients',
        'course_outlines', 'events', 'links', 'month_kpis', 'payments',
        'pipelines', 'project_pls', 'quotations', 'reps', 'tasks',
        'trainers_directory', 'venues_directory'
      ];
    }
  }
}
